$form->prepare();
?>
<?php echo $this->pageTitle($translate('Add new key'), 1, $translate('MCP Server')); ?>
<?php echo $this->form()->openTag($form); ?>
<div id="page-actions">
    <?php echo $this->hyperlink($translate('Cancel'), $this->url('admin/mcp-server', ['controller' => 'key']), ['class' => 'button']); ?>
    <button type="submit"><?php echo $escape($translate('Create key')); ?></button>
</div>
<p><?php echo $translate('Name the key after where it\'s used, such as "Claude desktop", to tell keys apart. Omeka shows its address only once, after it\'s created.'); ?></p>
<?php echo $this->formCollection($form, false); ?>
<?php echo $this->form()->closeTag(); ?>
